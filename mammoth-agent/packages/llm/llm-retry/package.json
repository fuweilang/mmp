{
  "name": "@mammoth-ai/mmp-llm-retry",
  "description": "Provider-routed LLM request retry policy for the DeepSeek Harness",
  "version": "0.3.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/llm/llm-retry"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@mammoth-ai/mmp-brand": "workspace:*",
    "@mammoth-ai/mmp-agent": "workspace:*",
    "@mammoth-ai/mmp-llm": "workspace:*",
    "@mammoth-ai/mmp-session": "workspace:*",
    "@mammoth-ai/mmp-timeout": "workspace:*",
    "@mammoth-ai/cordis": "workspace:~",
    "@mammoth-ai/mmp-session-projection": "workspace:*"
  },
  "dependencies": {
    "@mammoth-ai/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@mammoth-ai/mmp-brand": "workspace:*",
    "@mammoth-ai/cordis-plugin-include": "workspace:~",
    "@mammoth-ai/cordis-plugin-loader": "workspace:~",
    "@mammoth-ai/mmp-agent": "workspace:*",
    "@mammoth-ai/mmp-agent-loop": "workspace:*",
    "@mammoth-ai/mmp-agent-loop-testkit": "workspace:*",
    "@mammoth-ai/mmp-llm": "workspace:*",
    "@mammoth-ai/mmp-llm-deepseek": "workspace:*",
    "@mammoth-ai/mmp-llm-deepseek-api-key": "workspace:*",
    "@mammoth-ai/mmp-llm-mock-server": "workspace:*",
    "@mammoth-ai/mmp-session": "workspace:*",
    "@mammoth-ai/mmp-session-projection": "workspace:*",
    "@mammoth-ai/mmp-session-persistence-jsonl": "workspace:*",
    "@mammoth-ai/mmp-system-prompt": "workspace:*",
    "@mammoth-ai/mmp-timeout": "workspace:*",
    "@mammoth-ai/mmp-tool-executor-native": "workspace:*",
    "@mammoth-ai/mmp-tool-testkit": "workspace:*",
    "@mammoth-ai/mmp-tools": "workspace:*",
    "@mammoth-ai/cordis": "workspace:~"
  }
