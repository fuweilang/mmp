    "@mammoth-ai/mmp-authorization": "workspace:*",
    "@mammoth-ai/mmp-credentials": "workspace:*",
    "@mammoth-ai/mmp-fs": "workspace:*",
    "@mammoth-ai/mmp-launch-environment": "workspace:*",
    "@mammoth-ai/mmp-llm": "workspace:*",
    "@mammoth-ai/mmp-timeout": "workspace:*"
  },
  "dependencies": {
    "@mammoth-ai/mmp-brand": "workspace:*",
    "@mammoth-ai/mmp-util-values": "workspace:*",
    "@mammoth-ai/schemastery": "workspace:~",
    "@earendil-works/pi-ai": "^1.3.0"
  },
  "devDependencies": {
    "@mammoth-ai/cordis": "workspace:~",
    "@mammoth-ai/cordis-plugin-loader": "workspace:~",
    "@mammoth-ai/mmp-agent-loop-testkit": "workspace:*",
    "@mammoth-ai/mmp-attachment": "workspace:*",
    "@mammoth-ai/mmp-authorization": "workspace:*",
    "@mammoth-ai/mmp-credentials": "workspace:*",
    "@mammoth-ai/mmp-fs": "workspace:*",
    "@mammoth-ai/mmp-http-proxy": "workspace:*",
    "@mammoth-ai/mmp-launch-environment": "workspace:*",
    "@mammoth-ai/mmp-llm": "workspace:*",
    "@mammoth-ai/mmp-llm-deepseek": "workspace:*",
    "@mammoth-ai/mmp-llm-deepseek-api-key": "workspace:*",
    "@mammoth-ai/mmp-session": "workspace:*",
    "@mammoth-ai/mmp-settings": "workspace:*",
    "@mammoth-ai/mmp-timeout": "workspace:*",
    "@mammoth-ai/mmp-tool-testkit": "workspace:*",
    "@mammoth-ai/mmp-tools": "workspace:*"
