{
  "name": "@mammoth-ai/mmp-deepseek-account-platform",
  "description": "Authorize DeepSeek accounts through browser PKCE",
  "version": "0.3.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/credentials/deepseek-account-platform"
  },
  "type": "module",
  "main": "lib/types/index.js",
