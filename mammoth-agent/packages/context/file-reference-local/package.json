{
  "name": "@mammoth-ai/mmp-file-reference-local",
  "description": "Local-filesystem ctx.fileReferences provider with bounded fuzzy indexes",
  "version": "0.3.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/context/file-reference-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./search": {
      "types": "./lib/types/search.d.ts",
      "default": "./lib/types/search.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@mammoth-ai/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@mammoth-ai/mmp-agent": "workspace:*",
    "@mammoth-ai/mmp-file-reference": "workspace:*",
    "@mammoth-ai/mmp-system-prompt": "workspace:*",
    "@mammoth-ai/mmp-tools": "workspace:*",
    "@mammoth-ai/cordis": "workspace:~",
    "@mammoth-ai/mmp-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@mammoth-ai/mmp-agent": "workspace:*",
    "@mammoth-ai/mmp-file-reference": "workspace:*",
    "@mammoth-ai/mmp-system-prompt": "workspace:*",
    "@mammoth-ai/mmp-tool-executor-native": "workspace:*",
    "@mammoth-ai/mmp-tool-testkit": "workspace:*",
    "@mammoth-ai/mmp-tools": "workspace:*",
    "@mammoth-ai/cordis": "workspace:~",
    "@mammoth-ai/mmp-working-directory": "workspace:*",
    "@mammoth-ai/mmp-fs-local": "workspace:*",
    "@mammoth-ai/mmp-session-projection": "workspace:*"
  }
}
