{
  "name": "@mammoth-ai/mmp-experimental-auto-review",
  "description": "Per-tool LLM authorization review for the DeepSeek Harness Auto permission preset",
  "version": "0.3.4",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/auto-review"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@mammoth-ai/mmp-agent": "workspace:*",
    "@mammoth-ai/mmp-agent-instructions": "workspace:*",
    "@mammoth-ai/mmp-llm": "workspace:*",
    "@mammoth-ai/mmp-permission-presets": "workspace:*",
    "@mammoth-ai/mmp-session": "workspace:*",
    "@mammoth-ai/mmp-tools": "workspace:*",
    "@mammoth-ai/cordis": "workspace:~",
    "@mammoth-ai/mmp-working-directory": "workspace:*"
  },
  "dependencies": {
    "@mammoth-ai/mmp-util-values": "workspace:*"
  },
  "devDependencies": {
    "@mammoth-ai/mmp-agent": "workspace:*",
    "@mammoth-ai/mmp-agent-instructions": "workspace:*",
    "@mammoth-ai/mmp-agent-loop": "workspace:*",
    "@mammoth-ai/mmp-agent-loop-testkit": "workspace:*",
    "@mammoth-ai/mmp-bash-sandbox": "workspace:*",
    "@mammoth-ai/mmp-compaction": "workspace:*",
    "@mammoth-ai/mmp-fs-local": "workspace:*",
    "@mammoth-ai/mmp-fs-observation-policy": "workspace:*",
    "@mammoth-ai/mmp-fs-sandbox": "workspace:*",
    "@mammoth-ai/mmp-llm": "workspace:*",
    "@mammoth-ai/mmp-llm-deepseek": "workspace:*",
    "@mammoth-ai/mmp-llm-deepseek-api-key": "workspace:*",
    "@mammoth-ai/mmp-permission-presets": "workspace:*",
    "@mammoth-ai/mmp-ptc-runtime-node": "workspace:*",
    "@mammoth-ai/mmp-sandbox": "workspace:*",
    "@mammoth-ai/mmp-sandbox-policy": "workspace:*",
    "@mammoth-ai/mmp-session": "workspace:*",
    "@mammoth-ai/mmp-session-projection": "workspace:*",
    "@mammoth-ai/mmp-shell": "workspace:*",
    "@mammoth-ai/mmp-shell-env": "workspace:*",
    "@mammoth-ai/mmp-subagent": "workspace:*",
    "@mammoth-ai/mmp-subprocess-local": "workspace:*",
    "@mammoth-ai/mmp-system-prompt": "workspace:*",
    "@mammoth-ai/mmp-tool-bash": "workspace:*",
    "@mammoth-ai/mmp-tool-executor-native": "workspace:*",
    "@mammoth-ai/mmp-tool-executor-ptc": "workspace:*",
    "@mammoth-ai/mmp-tool-fs": "workspace:*",
    "@mammoth-ai/mmp-tool-subagent": "workspace:*",
    "@mammoth-ai/mmp-tool-testkit": "workspace:*",
    "@mammoth-ai/mmp-tools": "workspace:*",
    "@mammoth-ai/mmp-user-approval": "workspace:*",
    "@mammoth-ai/cordis": "workspace:~",
    "@mammoth-ai/mmp-working-directory": "workspace:*"
