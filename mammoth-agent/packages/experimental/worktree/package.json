{
  "name": "@mammoth-ai/mmp-experimental-worktree",
  "description": "Creates a named Git worktree and changes the calling Session working directory",
  "version": "0.3.4",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/worktree"
  },
  "dependencies": {
    "@mammoth-ai/schemastery": "workspace:~",
    "@mammoth-ai/mmp-timeout": "workspace:*"
  },
  "peerDependencies": {
    "@mammoth-ai/cordis": "workspace:~",
    "@mammoth-ai/mmp-agent": "workspace:*",
    "@mammoth-ai/mmp-fs": "workspace:*",
    "@mammoth-ai/mmp-sandbox": "workspace:*",
    "@mammoth-ai/mmp-sandbox-policy": "workspace:*",
    "@mammoth-ai/mmp-subprocess": "workspace:*",
    "@mammoth-ai/mmp-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@mammoth-ai/cordis": "workspace:~",
    "@mammoth-ai/mmp-agent": "workspace:*",
    "@mammoth-ai/mmp-agent-loop-testkit": "workspace:*",
    "@mammoth-ai/mmp-fs": "workspace:*",
    "@mammoth-ai/mmp-fs-local": "workspace:*",
    "@mammoth-ai/mmp-sandbox": "workspace:*",
    "@mammoth-ai/mmp-sandbox-local": "workspace:*",
    "@mammoth-ai/mmp-sandbox-policy": "workspace:*",
    "@mammoth-ai/mmp-session": "workspace:*",
    "@mammoth-ai/mmp-session-projection": "workspace:*",
    "@mammoth-ai/mmp-subprocess": "workspace:*",
    "@mammoth-ai/mmp-subprocess-local": "workspace:*",
    "@mammoth-ai/mmp-system-prompt": "workspace:*",
    "@mammoth-ai/mmp-working-directory": "workspace:*"
  }
}
