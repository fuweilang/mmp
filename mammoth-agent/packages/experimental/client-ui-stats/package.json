{
  "name": "@mammoth-ai/mmp-experimental-client-ui-stats",
  "description": "Per-turn and per-step context, timing, cache, and tool-cost table contributed as an experimental conversation View",
  "version": "0.3.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/client-ui-stats"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "mmp": {
    "client": {
      "inject": [
        "@mammoth-ai/mmp-api-session-controller",
        "@mammoth-ai/mmp-client-locale",
        "@mammoth-ai/mmp-client-ui-conversation",
        "@mammoth-ai/mmp-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@mammoth-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@mammoth-ai/cordis": "workspace:~",
    "@mammoth-ai/mmp-api-session-controller": "workspace:*",
    "@mammoth-ai/mmp-attachment": "workspace:*",
    "@mammoth-ai/mmp-client-locale": "workspace:*",
    "@mammoth-ai/mmp-client-store": "workspace:*",
    "@mammoth-ai/mmp-client-test-runtime": "workspace:*",
    "@mammoth-ai/mmp-client-ui-conversation": "workspace:*",
    "@mammoth-ai/mmp-client-ui-primitives": "workspace:*",
    "@mammoth-ai/mmp-client-ui-renderer": "workspace:*",
    "@mammoth-ai/mmp-client-ui-session": "workspace:*",
    "@mammoth-ai/mmp-client-ui-slots": "workspace:*",
    "@mammoth-ai/mmp-llm": "workspace:*",
    "@mammoth-ai/mmp-llm-retry": "workspace:*",
    "@mammoth-ai/mmp-session": "workspace:*",
    "@mammoth-ai/mmp-tool-executor-ptc": "workspace:*",
    "@mammoth-ai/mmp-tools": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@mammoth-ai/mmp-compaction": "workspace:*",
    "@mammoth-ai/mmp-session-stats": "workspace:*",
    "@mammoth-ai/mmp-token-meter": "workspace:*",
    "@mammoth-ai/mmp-user-approval": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
