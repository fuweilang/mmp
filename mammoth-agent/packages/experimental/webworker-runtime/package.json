{
  "name": "@mammoth-ai/mmp-experimental-webworker-runtime",
  "description": "Browser-only harness runtime: in-memory VFS, module transform and loader, postMessage tunnel, and the dedicated Web Worker assembly, with the Node-compatibility layer that lets the host tree run unchanged",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/webworker-runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./worker": "./lib/worker.js",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@mammoth-ai/mmp-util-crypto": "workspace:*",
    "@noble/hashes": "^2.4.0",
    "@yarnpkg/parsers": "^3.1.0",
    "acorn": "^8.18.0",
    "buffer": "^6.0.3",
    "eslint-scope": "^9.1.2",
    "eslint-visitor-keys": "^5.0.1",
    "picomatch": "^4.0.7",
    "readable-stream": "^4.7.0",
    "@mammoth-ai/mmp-client-web": "workspace:*",
    "string_decoder": "^1.3.0"
  },
  "peerDependencies": {
    "@mammoth-ai/cordis": "workspace:~",
    "@mammoth-ai/cordis-plugin-loader": "workspace:~",
    "@mammoth-ai/mmp-client-connection": "workspace:*",
    "@mammoth-ai/mmp-client-modules": "workspace:*",
    "@mammoth-ai/mmp-host-webserver": "workspace:*"
  },
  "devDependencies": {
    "@mammoth-ai/cordis": "workspace:~",
    "@mammoth-ai/cordis-plugin-loader": "workspace:~",
    "@mammoth-ai/mmp-api-gateway": "workspace:*",
    "@mammoth-ai/mmp-app-boot": "workspace:*",
    "@mammoth-ai/mmp-bash-sandbox": "workspace:*",
    "@mammoth-ai/mmp-client-connection": "workspace:*",
    "@mammoth-ai/mmp-client-file-upload": "workspace:*",
    "@mammoth-ai/mmp-client-modules": "workspace:*",
    "@mammoth-ai/mmp-host-webserver": "workspace:*",
    "@mammoth-ai/mmp-sandbox-local": "workspace:*",
    "@mammoth-ai/mmp-sandbox-policy": "workspace:*",
    "@mammoth-ai/mmp-session": "workspace:*",
    "@mammoth-ai/mmp-session-projection": "workspace:*",
    "@mammoth-ai/mmp-session-persistence-jsonl": "workspace:*",
    "@mammoth-ai/mmp-subagent": "workspace:*",
    "@mammoth-ai/mmp-subprocess-local": "workspace:*",
    "@mammoth-ai/node-addon-system": "workspace:~",
    "@types/estree": "^1.0.9",
    "@types/picomatch": "^4.0.3",
    "@types/readable-stream": "^4.0.24",
    "chokidar": "5.0.0"
  },
  "files": [
    "lib/index.js",
    "lib/worker.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
