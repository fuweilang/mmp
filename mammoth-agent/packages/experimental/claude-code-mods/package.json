{
  "name": "@mammoth-ai/mmp-experimental-claude-code-mods",
  "description": "Experimental bridge: load Claude Code mods (hooks modules) and run their hook chains on DeepSeek Harness extension points",
  "version": "0.3.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/claude-code-mods"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./testing": {
      "types": "./lib/types/testing.d.ts",
      "default": "./lib/types/testing.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./examples/*": "./examples/*",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@mammoth-ai/mmp-util-crypto": "workspace:*",
    "@mammoth-ai/mmp-util-values": "workspace:*",
    "@mammoth-ai/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@mammoth-ai/cordis": "workspace:~",
    "@mammoth-ai/mmp-agent": "workspace:*",
    "@mammoth-ai/mmp-commands": "workspace:*",
    "@mammoth-ai/mmp-fs": "workspace:*",
    "@mammoth-ai/mmp-llm": "workspace:*",
    "@mammoth-ai/mmp-scope": "workspace:*",
    "@mammoth-ai/mmp-session": "workspace:*",
    "@mammoth-ai/mmp-storage-domain": "workspace:*",
    "@mammoth-ai/mmp-subprocess": "workspace:*",
    "@mammoth-ai/mmp-token-meter": "workspace:*",
    "@mammoth-ai/mmp-tools": "workspace:*",
    "@mammoth-ai/mmp-typert-protocol": "workspace:*",
    "@mammoth-ai/mmp-user-questions": "workspace:*",
    "@mammoth-ai/mmp-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@mammoth-ai/cordis": "workspace:~",
    "@mammoth-ai/cordis-plugin-include": "workspace:~",
    "@mammoth-ai/cordis-plugin-loader": "workspace:~",
    "@mammoth-ai/mmp-agent": "workspace:*",
    "@mammoth-ai/mmp-agent-loop": "workspace:*",
    "@mammoth-ai/mmp-agent-loop-testkit": "workspace:*",
    "@mammoth-ai/mmp-attachment": "workspace:*",
    "@mammoth-ai/mmp-commands": "workspace:*",
    "@mammoth-ai/mmp-fs": "workspace:*",
    "@mammoth-ai/mmp-fs-local": "workspace:*",
    "@mammoth-ai/mmp-llm": "workspace:*",
    "@mammoth-ai/mmp-scope": "workspace:*",
    "@mammoth-ai/mmp-session": "workspace:*",
    "@mammoth-ai/mmp-session-projection": "workspace:*",
    "@mammoth-ai/mmp-storage": "workspace:*",
    "@mammoth-ai/mmp-storage-domain": "workspace:*",
    "@mammoth-ai/mmp-storage-json": "workspace:*",
    "@mammoth-ai/mmp-subprocess": "workspace:*",
    "@mammoth-ai/mmp-subprocess-local": "workspace:*",
    "@mammoth-ai/mmp-system-prompt": "workspace:*",
    "@mammoth-ai/mmp-token-meter": "workspace:*",
    "@mammoth-ai/mmp-tool-executor-native": "workspace:*",
    "@mammoth-ai/mmp-tool-testkit": "workspace:*",
    "@mammoth-ai/mmp-tools": "workspace:*",
    "@mammoth-ai/mmp-typert-protocol": "workspace:*",
    "@mammoth-ai/mmp-user-questions": "workspace:*",
    "@mammoth-ai/mmp-working-directory": "workspace:*",
