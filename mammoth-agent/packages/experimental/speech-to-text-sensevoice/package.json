{
  "name": "@mammoth-ai/mmp-experimental-speech-to-text-sensevoice",
  "description": "Local SenseVoice ONNX transcription with a managed sherpa-onnx process",
  "version": "0.3.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/speech-to-text-sensevoice"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./worker": {
      "types": "./lib/types/worker.d.ts",
      "default": "./lib/worker.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/worker.js",
    "runtime/assets.json",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@mammoth-ai/schemastery": "workspace:~",
    "@mammoth-ai/mmp-timeout": "workspace:*",
    "zod": "4.4.3",
    "sherpa-onnx-node": "1.13.8"
  },
  "peerDependencies": {
    "@mammoth-ai/cordis": "workspace:~",
    "@mammoth-ai/mmp-experimental-speech-to-text": "workspace:*",
    "@mammoth-ai/mmp-subprocess": "workspace:*"
  },
  "devDependencies": {
    "@mammoth-ai/cordis": "workspace:~",
    "@mammoth-ai/mmp-experimental-speech-to-text": "workspace:*",
    "@mammoth-ai/mmp-subprocess": "workspace:*",
    "@mammoth-ai/mmp-subprocess-local": "workspace:*",
    "tsx": "^4.23.13"
  }
}
