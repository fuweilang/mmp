{
  "name": "@mammoth-ai/mmp-cua",
  "description": "Shared Computer Use application objects, authorization, and logged tool execution",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/cua"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./api": {
      "types": "./lib/types/api.d.ts",
      "default": "./lib/api.js"
    },
    "./bridge": {
      "types": "./lib/types/bridge.d.ts",
      "default": "./lib/bridge.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./lib/types/remote-types.d.ts",
      "default": "./lib/remote-types.js"
    },
    "./native-client": {
      "types": "./lib/types/native-client.d.ts",
      "default": "./lib/native-client.js"
    },
    "./protocol": {
      "types": "./lib/types/protocol.d.ts",
      "default": "./lib/protocol.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/remote-types.js",
    "lib/api.js",
    "lib/bridge.js",
    "lib/native-client.js",
    "lib/protocol.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@mammoth-ai/cordis": "workspace:~",
    "@mammoth-ai/mmp-user-questions": "workspace:*",
    "@mammoth-ai/mmp-attachment": "workspace:*",
    "@mammoth-ai/mmp-scope": "workspace:*",
    "@mammoth-ai/mmp-ptc-runtime-node": "workspace:*"
  },
  "dependencies": {
    "@mammoth-ai/schemastery": "workspace:~",
    "zod": "^4.4.3",
    "@mammoth-ai/mmp-atomic-write": "workspace:*",
    "@mammoth-ai/mmp-typert-protocol": "workspace:*",
    "@mammoth-ai/mmp-computer-use": "workspace:*",
    "@mammoth-ai/mmp-storage-domain": "workspace:*"
  },
  "devDependencies": {
    "@mammoth-ai/mmp-working-directory": "workspace:*",
    "@mammoth-ai/cordis": "workspace:~",
    "@mammoth-ai/cordis-plugin-include": "workspace:~",
    "@mammoth-ai/cordis-plugin-loader": "workspace:~",
    "@mammoth-ai/mmp-agent": "workspace:*",
    "@mammoth-ai/mmp-agent-loop": "workspace:*",
    "@mammoth-ai/mmp-agent-loop-testkit": "workspace:*",
    "@mammoth-ai/mmp-attachment": "workspace:*",
    "@mammoth-ai/mmp-attachment-local": "workspace:*",
    "@mammoth-ai/mmp-llm": "workspace:*",
    "@mammoth-ai/mmp-session": "workspace:*",
    "@mammoth-ai/mmp-session-projection": "workspace:*",
    "@mammoth-ai/mmp-system-prompt": "workspace:*",
    "@mammoth-ai/mmp-tools": "workspace:*",
    "@mammoth-ai/mmp-subprocess": "workspace:*",
    "@mammoth-ai/mmp-subprocess-local": "workspace:*",
    "@mammoth-ai/mmp-fs-local": "workspace:*",
    "@mammoth-ai/mmp-llm-deepseek": "workspace:*",
    "@mammoth-ai/mmp-ptc-runtime-node": "workspace:*",
    "@mammoth-ai/mmp-sandbox-local": "workspace:*",
    "@mammoth-ai/mmp-sandbox-policy": "workspace:*",
    "sharp": "^0.35.3",
    "@mammoth-ai/mmp-ptc-runtime": "workspace:*",
    "@mammoth-ai/mmp-user-questions": "workspace:*",
    "@mammoth-ai/mmp-app-boot": "workspace:*",
    "@mammoth-ai/mmp-config-editor": "workspace:*",
    "@mammoth-ai/mmp-hmr": "workspace:*",
    "@mammoth-ai/cordis-plugin-timer": "workspace:~",
    "@mammoth-ai/mmp-scope": "workspace:*",
    "@mammoth-ai/mmp-agent-preset-registry": "workspace:*",
    "@mammoth-ai/mmp-api-remotes": "workspace:*",
    "@mammoth-ai/mmp-api-gateway": "workspace:*",
    "@mammoth-ai/mmp-client-locale": "workspace:*",
    "@mammoth-ai/mmp-client-store": "workspace:*",
    "@mammoth-ai/mmp-client-ui-primitives": "workspace:*",
    "@mammoth-ai/mmp-client-ui-renderer": "workspace:*",
    "@mammoth-ai/mmp-client-ui-slots": "workspace:*",
    "@mammoth-ai/mmp-client-ui-plugin-manager": "workspace:*",
    "@mammoth-ai/mmp-client-ui-settings": "workspace:*",
    "@mammoth-ai/mmp-client-ui-layout": "workspace:*",
    "@mammoth-ai/mmp-client-test-runtime": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@testing-library/react": "^16.1.0",
    "@mammoth-ai/mmp-loader-smoke": "workspace:*",
    "@mammoth-ai/mmp-util-values": "workspace:*",
    "@mammoth-ai/mmp-brand": "workspace:*",
    "@mammoth-ai/mmp-storage": "workspace:*",
    "@mammoth-ai/mmp-storage-json": "workspace:*",
    "@mammoth-ai/mmp-client-ui-user-questions": "workspace:*",
    "@mammoth-ai/mmp-client-ui-approval": "workspace:*",
    "@mammoth-ai/mmp-client-ui-conversation": "workspace:*"
  },
  "mmp": {
    "client": {
      "inject": [
        "@mammoth-ai/mmp-api-remotes",
        "@mammoth-ai/mmp-client-locale",
        "@mammoth-ai/mmp-client-ui-plugin-manager",
        "@mammoth-ai/mmp-client-ui-settings",
        "@mammoth-ai/mmp-client-ui-layout",
        "@mammoth-ai/mmp-client-ui-user-questions",
        "@mammoth-ai/mmp-client-ui-approval",
        "@mammoth-ai/mmp-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  }
}
