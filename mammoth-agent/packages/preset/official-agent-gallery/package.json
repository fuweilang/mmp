{
  "name": "@mammoth-ai/mmp-official-agent-gallery",
  "description": "Ground official Agent Remote service, frozen Sessions, controlled knowledge tools, and usage attribution",
  "version": "0.3.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/preset/official-agent-gallery"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "scripts": {
    "prebundle": "tsc -b --force",
    "bundle": "tsdown",
    "watch": "tsc -b --force && tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@mammoth-ai/cordis": "workspace:~",
    "@mammoth-ai/mmp-agent": "workspace:*",
