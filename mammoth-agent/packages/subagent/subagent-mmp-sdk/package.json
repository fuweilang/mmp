{
  "name": "@mammoth-ai/mmp-subagent-mmp-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child DeepSeek Harness runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "0.3.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/subagent/subagent-mmp-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@mammoth-ai/cordis": "workspace:~",
    "@mammoth-ai/mmp-agent": "workspace:*",
    "@mammoth-ai/mmp-llm": "workspace:*",
    "@mammoth-ai/mmp-sdk-client": "workspace:*",
    "@mammoth-ai/mmp-session": "workspace:*",
    "@mammoth-ai/mmp-subagent": "workspace:*",
    "@mammoth-ai/mmp-subprocess": "workspace:*"
  },
  "dependencies": {
    "@mammoth-ai/mmp-brand": "workspace:*",
    "@mammoth-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@mammoth-ai/cordis": "workspace:~",
    "@mammoth-ai/cordis-plugin-loader": "workspace:~",
    "@mammoth-ai/mmp-agent": "workspace:*",
    "@mammoth-ai/mmp-agent-instructions": "workspace:*",
    "@mammoth-ai/mmp-app-boot": "workspace:*",
    "@mammoth-ai/mmp-llm": "workspace:*",
    "@mammoth-ai/mmp-llm-deepseek": "workspace:*",
    "@mammoth-ai/mmp-llm-deepseek-api-key": "workspace:*",
    "@mammoth-ai/mmp-loader-smoke": "workspace:*",
    "@mammoth-ai/mmp-sdk-client": "workspace:*",
    "@mammoth-ai/mmp-sdk-protocol": "workspace:*",
    "@mammoth-ai/mmp-session": "workspace:*",
    "@mammoth-ai/mmp-session-checkpoint-policy": "workspace:*",
    "@mammoth-ai/mmp-session-persistence-jsonl": "workspace:*",
    "@mammoth-ai/mmp-session-projection": "workspace:*",
    "@mammoth-ai/mmp-skill-filesystem": "workspace:*",
    "@mammoth-ai/mmp-subagent": "workspace:*",
    "@mammoth-ai/mmp-subprocess": "workspace:*",
    "@mammoth-ai/mmp-system-prompt": "workspace:*",
    "@mammoth-ai/mmp-tool-subagent": "workspace:*"
  }
}
