{
  "name": "@mammoth-ai/mmp-session-format-v4-to-v5",
  "description": "Identity-preserving Session V4 to V5 migration and required-event admission",
  "version": "0.3.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/session-format-v4-to-v5"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "mmp": {
    "sessionFormatMigration": {
      "from": 4,
      "to": 5,
      "export": ".",
      "migration": "sessionFormatV4ToV5",
      "sourceCodec": "releasedV4SessionFormatCodec",
      "targetCodec": "releasedV5SessionFormatCodec",
      "targetHeaderValidator": "assertReleasedV5Header",
      "targetRestorer": "restoreReleasedV5Artifact"
    }
  },
  "dependencies": {
    "@mammoth-ai/mmp-session-format": "workspace:*",
    "@mammoth-ai/mmp-session-format-v3-to-v4": "workspace:*"
  },
  "peerDependencies": {
    "@mammoth-ai/cordis": "workspace:~",
    "@mammoth-ai/mmp-session": "workspace:*"
  },
  "devDependencies": {
    "@mammoth-ai/cordis": "workspace:~",
    "@mammoth-ai/mmp-session": "workspace:*"
  }
}
