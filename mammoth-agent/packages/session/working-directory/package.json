{
  "name": "@mammoth-ai/mmp-working-directory",
  "description": "Session working directories with durable changes and model context",
  "version": "0.3.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/working-directory"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@mammoth-ai/cordis": "workspace:~",
    "@mammoth-ai/mmp-agent": "workspace:*",
    "@mammoth-ai/mmp-fs": "workspace:*",
    "@mammoth-ai/mmp-llm": "workspace:*",
    "@mammoth-ai/mmp-session": "workspace:*",
    "@mammoth-ai/mmp-session-projection": "workspace:*",
    "@mammoth-ai/mmp-system-prompt": "workspace:*"
  },
  "devDependencies": {
    "@mammoth-ai/mmp-sandbox-policy": "workspace:*",
    "@mammoth-ai/mmp-user-approval": "workspace:*",
    "@mammoth-ai/cordis": "workspace:~",
    "@mammoth-ai/mmp-agent": "workspace:*",
    "@mammoth-ai/mmp-fs": "workspace:*",
    "@mammoth-ai/mmp-llm": "workspace:*",
    "@mammoth-ai/mmp-session": "workspace:*",
    "@mammoth-ai/mmp-session-projection": "workspace:*",
    "@mammoth-ai/mmp-system-prompt": "workspace:*",
    "@mammoth-ai/mmp-agent-loop-testkit": "workspace:*",
    "@mammoth-ai/mmp-fs-local": "workspace:*",
    "@mammoth-ai/mmp-tool-testkit": "workspace:*",
    "@mammoth-ai/mmp-tool-working-directory": "workspace:*",
    "@mammoth-ai/mmp-tools": "workspace:*"
  },
  "dependencies": {
    "@mammoth-ai/schemastery": "workspace:~",
    "zod": "^4.4.3"
  }
}
