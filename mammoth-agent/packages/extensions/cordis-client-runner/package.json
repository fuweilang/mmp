{
  "name": "@mammoth-ai/mmp-cordis-client-runner",
  "description": "Browser half of dynamic dual-half plugin packages: event subscription, closure evaluation, guard facade, and loader entries",
  "version": "0.3.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/extensions/cordis-client-runner"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "mmp": {
    "client": {
      "inject": [
        "@mammoth-ai/mmp-client-ui-renderer",
        "@mammoth-ai/mmp-api-remotes",
        "@mammoth-ai/mmp-client-modules",
        "@mammoth-ai/mmp-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@mammoth-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@mammoth-ai/cordis-plugin-loader": "workspace:~",
    "@mammoth-ai/cordis-plugin-timer": "workspace:~",
    "@mammoth-ai/mmp-api-remotes": "workspace:*",
    "@mammoth-ai/mmp-client-modules": "workspace:*",
    "@mammoth-ai/mmp-client-ui-renderer": "workspace:*",
    "@mammoth-ai/mmp-client-ui-theme": "workspace:*",
    "@mammoth-ai/cordis": "workspace:~",
    "react": "^18.2.0",
    "@mammoth-ai/mmp-util-values": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
