{
  "name": "@mammoth-ai/mmp-web-search-exa",
  "description": "Exa-backed search provider for the DeepSeek Harness web capability seam (ctx.web)",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/web/web-search-exa"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@mammoth-ai/mmp-launch-environment": "workspace:*",
    "@mammoth-ai/mmp-web": "workspace:*",
    "@mammoth-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@mammoth-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@mammoth-ai/mmp-launch-environment": "workspace:*",
    "@mammoth-ai/mmp-web": "workspace:*",
    "@mammoth-ai/cordis": "workspace:~",
    "@mammoth-ai/mmp-http-proxy": "workspace:*"
  }
}
