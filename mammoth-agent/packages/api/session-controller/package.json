    "@mammoth-ai/mmp-client-connection": "workspace:*",
    "@mammoth-ai/mmp-client-file-upload": "workspace:*",
    "@mammoth-ai/mmp-client-store": "workspace:*",
    "@mammoth-ai/mmp-client-test-runtime": "workspace:*",
