    "@mammoth-ai/mmp-permission-presets": "workspace:*",
    "@mammoth-ai/mmp-remote-mock": "workspace:*",
    "@mammoth-ai/mmp-scope": "workspace:*",
    "@mammoth-ai/mmp-session": "workspace:*",
    "@mammoth-ai/mmp-session-persistence": "workspace:*",
    "@mammoth-ai/mmp-session-persistence-jsonl": "workspace:*",
    "@mammoth-ai/mmp-session-projection": "workspace:*",
