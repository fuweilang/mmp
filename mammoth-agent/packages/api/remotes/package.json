{
  "name": "@mammoth-ai/mmp-api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "0.3.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "mmp": {
    "client": {
      "inject": [
        "@mammoth-ai/mmp-api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@mammoth-ai/mmp-deque": "workspace:*",
    "@mammoth-ai/mmp-util-values": "workspace:*"
  },
  "peerDependencies": {
    "@mammoth-ai/cordis": "workspace:~",
    "@mammoth-ai/mmp-scope": "workspace:*"
  },
  "devDependencies": {
    "@mammoth-ai/mmp-agent": "workspace:*",
    "@mammoth-ai/mmp-agent-preset-registry": "workspace:*",
    "@mammoth-ai/mmp-api-gateway": "workspace:*",
    "@mammoth-ai/mmp-api-job-controller": "workspace:*",
    "@mammoth-ai/mmp-api-session-controller": "workspace:*",
    "@mammoth-ai/mmp-api-settings-controller": "workspace:*",
    "@mammoth-ai/mmp-api-workspace-controller": "workspace:*",
    "@mammoth-ai/mmp-api-workspace-files": "workspace:*",
    "@mammoth-ai/mmp-client-connection": "workspace:*",
    "@mammoth-ai/mmp-client-file-upload": "workspace:*",
    "@mammoth-ai/mmp-commands": "workspace:*",
    "@mammoth-ai/mmp-cordis-host-runner": "workspace:*",
    "@mammoth-ai/mmp-credentials": "workspace:*",
    "@mammoth-ai/mmp-file-reference": "workspace:*",
    "@mammoth-ai/mmp-goal": "workspace:*",
    "@mammoth-ai/mmp-host-plugin-inventory": "workspace:*",
    "@mammoth-ai/mmp-llm": "workspace:*",
    "@mammoth-ai/mmp-message-feedback": "workspace:*",
    "@mammoth-ai/mmp-permission-presets": "workspace:*",
    "@mammoth-ai/mmp-schedule": "workspace:*",
    "@mammoth-ai/mmp-scope": "workspace:*",
    "@mammoth-ai/mmp-session": "workspace:*",
    "@mammoth-ai/mmp-session-reference": "workspace:*",
    "@mammoth-ai/mmp-settings": "workspace:*",
    "@mammoth-ai/mmp-subagent": "workspace:*",
    "@mammoth-ai/mmp-typert-protocol": "workspace:*",
    "@mammoth-ai/mmp-user-approval": "workspace:*",
    "@mammoth-ai/mmp-user-questions": "workspace:*",
    "@mammoth-ai/cordis": "workspace:~",
    "zod": "4.4.3",
    "@mammoth-ai/mmp-command-feedback": "workspace:*",
    "@mammoth-ai/mmp-api-terminal-controller": "workspace:*",
    "@mammoth-ai/mmp-plugin-manager": "workspace:*",
    "@mammoth-ai/mmp-plugin-market": "workspace:*",
    "@mammoth-ai/mmp-client-ui-plugin-manager": "workspace:*",
    "@mammoth-ai/mmp-office-to-pdf": "workspace:*",
    "@mammoth-ai/mmp-api-account-controller": "workspace:*",
    "@mammoth-ai/mmp-deepseek-account": "workspace:*",
    "@mammoth-ai/mmp-client-product-analytics": "workspace:*",
    "@mammoth-ai/mmp-client-ui-trajectory": "workspace:*",
    "@mammoth-ai/mmp-official-agent-gallery": "workspace:*"
  }
}
