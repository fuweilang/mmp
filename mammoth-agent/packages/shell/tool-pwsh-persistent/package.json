{
  "name": "@mammoth-ai/mmp-tool-pwsh-persistent",
  "description": "Model-facing owner-scoped persistent PowerShell tool backed by the Harness PTY service",
  "version": "0.3.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/shell/tool-pwsh-persistent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@mammoth-ai/mmp-agent": "workspace:*",
    "@mammoth-ai/mmp-output-retention": "workspace:*",
    "@mammoth-ai/mmp-terminal": "workspace:*",
    "@mammoth-ai/mmp-timeout": "workspace:*",
    "@mammoth-ai/mmp-tools": "workspace:*",
    "@mammoth-ai/cordis": "workspace:~",
    "@mammoth-ai/mmp-working-directory": "workspace:*"
  },
  "dependencies": {
    "@mammoth-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@mammoth-ai/cordis-plugin-include": "workspace:~",
    "@mammoth-ai/cordis-plugin-loader": "workspace:~",
    "@mammoth-ai/mmp-agent": "workspace:*",
    "@mammoth-ai/mmp-agent-loop-testkit": "workspace:*",
    "@mammoth-ai/mmp-llm": "workspace:*",
    "@mammoth-ai/mmp-output-retention": "workspace:*",
    "@mammoth-ai/mmp-terminal": "workspace:*",
    "@mammoth-ai/mmp-terminal-bash": "workspace:*",
    "@mammoth-ai/mmp-pwsh-local": "workspace:*",
    "@mammoth-ai/mmp-sandbox": "workspace:*",
    "@mammoth-ai/mmp-sandbox-policy": "workspace:*",
    "@mammoth-ai/mmp-session": "workspace:*",
    "@mammoth-ai/mmp-session-projection": "workspace:*",
    "@mammoth-ai/mmp-subprocess-local": "workspace:*",
    "@mammoth-ai/mmp-system-prompt": "workspace:*",
    "@mammoth-ai/mmp-timeout": "workspace:*",
    "@mammoth-ai/mmp-tool-executor-native": "workspace:*",
    "@mammoth-ai/mmp-tool-testkit": "workspace:*",
    "@mammoth-ai/mmp-tools": "workspace:*",
    "@mammoth-ai/cordis": "workspace:~",
    "@mammoth-ai/mmp-working-directory": "workspace:*"
  }
