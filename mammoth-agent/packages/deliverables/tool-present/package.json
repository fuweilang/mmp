{
  "name": "@mammoth-ai/mmp-tool-present",
  "description": "Explicit workspace file delivery declarations for the DeepSeek Harness",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/deliverables/tool-present"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "license": "MIT",
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@mammoth-ai/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@mammoth-ai/cordis": "workspace:~",
    "@mammoth-ai/mmp-agent": "workspace:*",
    "@mammoth-ai/mmp-fs": "workspace:*",
    "@mammoth-ai/mmp-llm": "workspace:*",
    "@mammoth-ai/mmp-session": "workspace:*",
    "@mammoth-ai/mmp-tools": "workspace:*",
    "@mammoth-ai/mmp-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@mammoth-ai/cordis": "workspace:~",
    "@mammoth-ai/mmp-agent": "workspace:*",
    "@mammoth-ai/mmp-fs": "workspace:*",
    "@mammoth-ai/mmp-llm": "workspace:*",
    "@mammoth-ai/mmp-session": "workspace:*",
    "@mammoth-ai/mmp-session-projection": "workspace:*",
    "@mammoth-ai/mmp-tool-executor-native": "workspace:*",
    "@mammoth-ai/mmp-tool-testkit": "workspace:*",
    "@mammoth-ai/mmp-tools": "workspace:*",
    "@mammoth-ai/mmp-agent-loop": "workspace:*",
    "@mammoth-ai/mmp-agent-loop-testkit": "workspace:*",
    "@mammoth-ai/mmp-fs-local": "workspace:*",
    "@mammoth-ai/mmp-scope": "workspace:*",
    "@mammoth-ai/mmp-working-directory": "workspace:*"
  }
}
