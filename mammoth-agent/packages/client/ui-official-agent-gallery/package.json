{
  "name": "@mammoth-ai/mmp-client-ui-official-agent-gallery",
  "description": "Shared Mac/Web browser UI for the Ground official Agent gallery",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-official-agent-gallery"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./assets/*": "./lib/assets/*"
  },
  "mmp": {
    "client": {
      "inject": [
        "@mammoth-ai/mmp-api-remotes",
        "@mammoth-ai/mmp-client-locale",
        "@mammoth-ai/mmp-client-ui-layout",
        "@mammoth-ai/mmp-client-ui-sidebar",
        "@mammoth-ai/mmp-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@mammoth-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@mammoth-ai/cordis": "workspace:~",
    "@mammoth-ai/mmp-api-remotes": "workspace:*",
    "@mammoth-ai/mmp-client-locale": "workspace:*",
    "@mammoth-ai/mmp-client-test-runtime": "workspace:*",
    "@mammoth-ai/mmp-client-ui-commands": "workspace:*",
    "@mammoth-ai/mmp-client-ui-layout": "workspace:*",
    "@mammoth-ai/mmp-client-ui-primitives": "workspace:*",
    "@mammoth-ai/mmp-client-ui-renderer": "workspace:*",
    "@mammoth-ai/mmp-client-ui-sidebar": "workspace:*",
    "@mammoth-ai/mmp-client-ui-slots": "workspace:*",
    "@mammoth-ai/mmp-client-ui-workspace": "workspace:*",
    "@mammoth-ai/mmp-official-agent-gallery": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/assets",
    "lib/types/**/*.d.ts"
  ]
}
