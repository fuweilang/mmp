{
  "name": "@mammoth-ai/mmp-client-ui-enterprise-library",
  "description": "Enterprise library sidebar and composer picker over the ground /api/library dataset",
  "version": "0.3.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "mmp": {
    "client": {
      "inject": [
        "@mammoth-ai/mmp-client-locale",
        "@mammoth-ai/mmp-client-ui-commands",
        "@mammoth-ai/mmp-client-ui-input-trigger",
        "@mammoth-ai/mmp-client-ui-layout",
        "@mammoth-ai/mmp-client-ui-renderer",
        "@mammoth-ai/mmp-client-ui-sidebar",
        "@mammoth-ai/mmp-client-ui-workspace",
        "@mammoth-ai/mmp-client-ui-session",
        "@mammoth-ai/mmp-api-session-controller",
        "@mammoth-ai/mmp-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@mammoth-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@mammoth-ai/cordis": "workspace:~",
    "@mammoth-ai/mmp-client-locale": "workspace:*",
    "@mammoth-ai/mmp-client-ui-commands": "workspace:*",
    "@mammoth-ai/mmp-client-ui-conversation": "workspace:*",
    "@mammoth-ai/mmp-client-ui-input-trigger": "workspace:*",
    "@mammoth-ai/mmp-client-ui-layout": "workspace:*",
    "@mammoth-ai/mmp-client-ui-primitives": "workspace:*",
    "@mammoth-ai/mmp-client-ui-renderer": "workspace:*",
    "@mammoth-ai/mmp-client-ui-sidebar": "workspace:*",
    "@mammoth-ai/mmp-client-ui-slots": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@mammoth-ai/mmp-client-ui-workspace": "workspace:*",
    "@mammoth-ai/mmp-client-ui-session": "workspace:*",
    "@mammoth-ai/mmp-api-session-controller": "workspace:*",
    "@mammoth-ai/mmp-session": "workspace:*",
    "@mammoth-ai/mmp-client-ui-sidebar-documentpreview": "workspace:*",
    "@mammoth-ai/mmp-client-ui-chat": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
