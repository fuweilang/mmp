{
  "name": "@mammoth-ai/mmp-client-ui-brand-official",
  "description": "Official DeepSeek Harness brand occupants for the Web client's sidebar slots",
  "version": "0.3.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-brand-official"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "mmp": {
    "client": {
      "inject": [
        "@mammoth-ai/mmp-client-ui-renderer",
        "@mammoth-ai/mmp-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@mammoth-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@mammoth-ai/mmp-client-ui-primitives": "workspace:*",
    "@mammoth-ai/mmp-client-ui-renderer": "workspace:*",
    "@mammoth-ai/mmp-client-ui-sidebar": "workspace:*",
    "@mammoth-ai/cordis": "workspace:~",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
