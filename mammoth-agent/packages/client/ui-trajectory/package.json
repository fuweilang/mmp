{
  "name": "@mammoth-ai/mmp-client-ui-trajectory",
  "description": "Trajectory event ledger and timing overview with live tool-result inspection",
  "version": "0.3.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-trajectory"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts"
    }
  },
  "mmp": {
    "client": {
      "inject": [
        "@mammoth-ai/mmp-api-session-controller",
        "@mammoth-ai/mmp-client-locale",
        "@mammoth-ai/mmp-client-ui-conversation",
        "@mammoth-ai/mmp-client-ui-renderer",
        "@mammoth-ai/mmp-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@mammoth-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@mammoth-ai/mmp-agent": "workspace:*",
    "@mammoth-ai/mmp-client-locale": "workspace:*",
    "@mammoth-ai/mmp-client-test-runtime": "workspace:*",
    "@mammoth-ai/mmp-client-ui-primitives": "workspace:*",
    "@mammoth-ai/mmp-client-ui-conversation": "workspace:*",
    "@mammoth-ai/mmp-tool-executor-ptc": "workspace:*",
    "@mammoth-ai/mmp-util-values": "workspace:*",
    "@mammoth-ai/mmp-client-ui-slots": "workspace:*",
    "@mammoth-ai/mmp-compaction": "workspace:*",
    "@mammoth-ai/cordis": "workspace:~",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@mammoth-ai/mmp-client-store": "workspace:*",
    "@mammoth-ai/mmp-client-ui-chat": "workspace:*",
    "@mammoth-ai/mmp-session": "workspace:*",
    "@mammoth-ai/mmp-api-session-controller": "workspace:*",
    "@mammoth-ai/mmp-client-ui-renderer": "workspace:*",
    "@mammoth-ai/mmp-client-ui-session": "workspace:*",
    "@mammoth-ai/mmp-llm": "workspace:*",
    "@mammoth-ai/mmp-attachment": "workspace:*",
    "@tanstack/react-virtual": "3.14.10",
    "diff": "^9.0.0",
    "@mammoth-ai/mmp-api-gateway": "workspace:*",
    "@mammoth-ai/mmp-tools": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "dependencies": {
    "@mammoth-ai/mmp-typert-protocol": "workspace:*",
    "zod": "4.4.3",
    "@mammoth-ai/schemastery": "workspace:~"
  }
}
