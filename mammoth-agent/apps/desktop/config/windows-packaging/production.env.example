# Copy to production.env in the same machine configuration directory and fill in the values.
MMP_DESKTOP_APP_ID=com.mammoth.ai.desktop
MMP_DESKTOP_AUTO_UPDATE_ENV=production
MMP_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
MMP_DESKTOP_MANDATORY_UPDATE_CONFIG='{}'
# MMP_DESKTOP_WINDOWS_SIGNATURE_CACHE_DIR=
MMP_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4
# Installer archive compression (0-9).
MMP_DESKTOP_WINDOWS_COMPRESSION_LEVEL=3
