# Copy to production.env and configure the production service before selecting this preset.
MMP_DESKTOP_APP_ID=com.mammoth.ai.desktop
MMP_DESKTOP_AUTO_UPDATE_ENV=production
MMP_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
MMP_DESKTOP_MACOS_PACK_CONCURRENCY=4
MMP_DESKTOP_MACOS_ZIP_COMPRESSION_LEVEL=3
MMP_DESKTOP_MACOS_DOWNLOAD_PROXY=
MMP_DESKTOP_MACOS_NOTARIZATION_PROXY=
# Optional absolute private directory; setup fills this in for machine presets. Omit to use checkout-local storage.
# MMP_DESKTOP_MACOS_SIGNATURE_CACHE_DIR=
