# Copy to production.env outside the source checkout; generate independent long random secrets.
PUBLIC_ORIGIN=https://www.mmai.vip
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET
COOKIE_NAME=mammothai_access_token
ALLOWED_ORIGINS=https://www.mmai.vip
OIDC_ISSUER=https://www.mmai.vip/console/api/oidc
OIDC_CLIENT_IDS=harness-desktop
OIDC_KEYS_FILE=/app/state/oidc-keys.json
# Real recharge stays closed until payment merchant credentials/certificates are configured.
PAY_PROVIDER=real
# These paths are on the Linux server, not the Mac.
MMP_WEB_HOST_DATA_ROOT=/www/mmp-prod/data/agent
MMP_WEB_MAX_IDENTITIES=4
MMP_WEB_WORKER_MEMORY_MB=1024
MMP_WEB_WORKER_CPUS=1
MMP_WEB_WORKER_PIDS=256
MMP_API_IMAGE=mmp-api:release
MMP_WEB_IMAGE=mmp-web:release
