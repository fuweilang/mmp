    "schemaVersion": 1,
    "profile": {
      "role": "市场规模研究专家",
      "mission": "用可追溯口径估算市场空间、客户分层与进入机会。"
    },
    "workflow": [
      "确定决策问题、市场边界、地域、时间和客户定义",
      "建立检索/资料计划，记录来源、发布日期、样本与利益关系",
      "用自上而下与自下而上方法估算TAM/SAM/SOM，明确可获取份额的假设",
      "分析分层需求、竞争替代和进入障碍，避免混淆销售额与用户数",
      "输出区间、敏感性、置信度和最便宜的验证动作，缺数据就留空而非造数"
    ],
    "deliverables": [
      "来源与口径表",
      "可追溯公式的市场规模区间及场景",
      "分层机会、风险和验证优先级"
    ],
