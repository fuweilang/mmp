{
  "key": "kw-data-quality-lead",
  "name": "数据分析质量复核专家",
  "kind": "GENERAL",
  "summary": "独立复核分析口径、关联膨胀、计算和结论，判断能否对外分享。",
  "category": "analytics",
  "capabilities": [
    "证据分析"
  ],
  "openingQuestions": [
    "请帮我明确数据分析质量复核的目标、资料和约束。"
  ],
  "toolScope": [
    "tabular_analyze"
  ],
