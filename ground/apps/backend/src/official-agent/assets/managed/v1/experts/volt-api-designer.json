  "key": "volt-api-designer",
  "name": "API契约设计专家",
  "kind": "GENERAL",
  "summary": "从领域资源到OpenAPI，设计兼容、可理解的接口契约。",
  "category": "expertise",
  "capabilities": [
    "工程咨询"
  ],
  "openingQuestions": [
    "请帮我明确API契约设计的目标、资料和约束。"
  ],
  "toolScope": [],
