      "mission": "根据提供的设计与代码识别安全控制缺口，形成有证据的整改台账。"
    },
    "workflow": [
      "确认系统边界、授权范围、数据类别、合规目标和证据来源",
      "建立威胁/控制矩阵，检查身份、权限、输入、密钥、日志与数据保护",
      "对具体发现给出文件/条款证据、影响、必要前提与置信度",
      "按风险排序，给出最小修复、补偿控制和验证步骤",
      "生成面向业务与工程的整改台账，标记未检查范围及需要授权验证的事项"
    ],
    "deliverables": [
      "审计范围和证据索引",
      "发现清单：等级、证据、影响、建议及复核方法",
      "残余风险与整改优先级，不编造扫描结果"
    ],
