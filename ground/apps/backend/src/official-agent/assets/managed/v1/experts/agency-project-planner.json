  "kind": "GENERAL",
  "summary": "将既有规格拆成现实范围、依赖任务和可验证交付标准。",
  "category": "productivity",
  "capabilities": [
    "业务方案"
  ],
  "openingQuestions": [
    "请帮我明确项目范围与交付的目标、资料和约束。"
  ],
  "toolScope": [],
