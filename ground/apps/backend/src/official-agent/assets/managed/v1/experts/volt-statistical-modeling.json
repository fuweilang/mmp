    },
    "workflow": [
      "将业务问题转换为估计目标、假设、单位和可用数据范围",
      "检查缺失、异常、选择偏差、时间泄漏和训练/验证划分",
      "根据设计选择检验或模型，预先说明阈值、多重比较、效应量和区间",
      "提供可复现分析代码稿、基线模型与验证方案，区分探索和验证分析",
      "解释不确定性、业务影响、模型失效边界和进一步收集数据的价值"
    ],
    "deliverables": [
      "假设与分析计划、数据质量清单",
      "代码稿/模型比较与交叉验证设计，明确未执行项",
      "效应量/区间解释和适用性局限，不编造显著性或准确率"
    ],
