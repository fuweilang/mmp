DATABASE_URL=postgresql://mammoth:mammoth@127.0.0.1:5433/mammoth_core
JWT_SECRET=change-me
PORT=3100
COOKIE_NAME=mammothai_access_token
OIDC_ISSUER=http://127.0.0.1:5201/console/api/oidc
OIDC_CLIENT_ID=mammoth-octop
# Comma-separated; includes Harness desktop PKCE client.
OIDC_CLIENT_IDS=mammoth-octop,harness-desktop
PUBLIC_ORIGIN=http://127.0.0.1:5201
# CORS 白名单（逗号分隔）；不配则默认本地开发地址 5201/5202/5203
# ALLOWED_ORIGINS=http://127.0.0.1:5201,https://console.example.com

# --- AI 币扫码充值（任务2；密钥勿提交；本地可用 PAY_PROVIDER=mock）---
PAY_PROVIDER=mock
PAY_NOTIFY_BASE_URL=http://127.0.0.1:5201
PAY_RETURN_BASE_URL=http://127.0.0.1:5201
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_SERIAL_NO=
# WECHAT_PAY_PRIVATE_KEY=
# WECHAT_PAY_PLATFORM_PUBLIC_KEY_ID=
# WECHAT_PAY_PLATFORM_PUBLIC_KEY=
# WECHAT_PAY_NOTIFY_URL=
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_NOTIFY_URL=

# 短信验证码。本地 mock，验证码默认 123456。生产设 SMS_PROVIDER=tencent 并填写腾讯云密钥。
# SMS_PROVIDER=mock
# MOCK_SMS_CODE=123456
# TENCENT_SMS_SECRET_ID=
# TENCENT_SMS_SECRET_KEY=
# TENCENT_SMS_SDK_APP_ID=
# TENCENT_SMS_SIGN_NAME=猛犸世纪
# TENCENT_SMS_REGION=ap-guangzhou
# TENCENT_SMS_TEMPLATE_ID=
# TENCENT_SMS_TEMPLATE_ID_LOGIN=
# TENCENT_SMS_TEMPLATE_ID_REGISTER=

# 厂商 API Key 加解密（AES-256-GCM）。不配则回落 JWT_SECRET。生产务必单独配置。
# LLM_API_KEY_SECRET=change-me-llm-key-secret

# 单个 Backend 进程的在途模型请求上限；0 表示不限制。
# 多实例部署时需改用共享限流存储。
# LLM_USER_MAX_CONCURRENCY=10
# LLM_TENANT_MAX_CONCURRENCY=50

# 官方模型参考价定时刷新：默认每 24 小时；设为 0 可关闭后台刷新。
# LLM_PRICE_REFRESH_ENABLED=1
# LLM_PRICE_REFRESH_INTERVAL_MS=86400000
