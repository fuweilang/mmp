  adapter String
  model String
  endpoint String
  dimension Int?
  tokenizer String
  timeoutMs Int @map("timeout_ms")
  batchSize Int @map("batch_size")
  maxInputTokens Int @map("max_input_tokens")
  maxResponseBytes Int @map("max_response_bytes")
