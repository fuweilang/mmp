model KnowledgeDocumentRevision {
  id String @id @default(cuid())
  documentId String @map("document_id")
  contentHash String @map("content_hash")
  parserFormat String @map("parser_format")
  originalName String @map("original_name")
  mediaType String @map("media_type")
  sizeBytes Int @map("size_bytes")
  storageKey String @map("storage_key")
  createdAt DateTime @default(now()) @map("created_at")
  document KnowledgeDocument @relation(fields:[documentId],references:[id],onDelete:Restrict)
  indexes KnowledgeIndexRevision[]
  @@unique([documentId, contentHash, parserFormat], map:"kc_revision_content_format_key")
  @@map("kc_document_revision")
}
model KnowledgeIndexRevision {
  id String @id @default(cuid())
  revisionId String @map("revision_id")
  profileId String @map("profile_id")
  parserVersion String @map("parser_version")
  chunkerVersion String @map("chunker_version")
  chunkerConfig Json @map("chunker_config")
  indexConfigHash String @map("index_config_hash")
  status String @default("PENDING")
  reasonCode String? @map("reason_code")
  chunkCount Int @default(0) @map("chunk_count")
  tokenCount Int @default(0) @map("token_count")
  createdAt DateTime @default(now()) @map("created_at")
  readyAt DateTime? @map("ready_at")
  revision KnowledgeDocumentRevision @relation(fields:[revisionId],references:[id],onDelete:Restrict)
  profile KnowledgeProfile @relation(fields:[profileId],references:[id],onDelete:Restrict)
  chunks KnowledgeChunk[]
  job KnowledgeIngestionJob?
  releaseItems KnowledgeReleaseItem[]
  requestedFor KnowledgeDocument? @relation("RequestedFileIndex")
  @@unique([revisionId, profileId, indexConfigHash], map:"kc_index_revision_config_key")
  @@index([status])
  @@map("kc_index_revision")
}
model KnowledgeChunk {
  id String @id @default(cuid())
  indexRevisionId String @map("index_revision_id")
  ordinal Int
  text String @db.Text
  sourceText String @map("source_text") @db.Text
  contentHash String @map("content_hash")
  tokenCount Int @map("token_count")
  tokenizer String
  sourceStart Int @map("source_start")
  sourceEnd Int @map("source_end")
  locator Json
  index KnowledgeIndexRevision @relation(fields:[indexRevisionId],references:[id],onDelete:Restrict)
  embedding KnowledgeEmbedding?
  @@unique([indexRevisionId, ordinal])
  @@map("kc_chunk")
}
model KnowledgeEmbedding {
  chunkId String @id @map("chunk_id")
  dimension Int
  vector Unsupported("vector")
  chunk KnowledgeChunk @relation(fields:[chunkId],references:[id],onDelete:Restrict)
  @@map("kc_embedding")
}
model KnowledgeIngestionJob {
  id String @id @default(cuid())
  baseId String @map("base_id")
  idempotencyKey String @map("idempotency_key")
  requestHash String @map("request_hash")
  indexRevisionId String @unique @map("index_revision_id")
  status String @default("QUEUED")
  stage String @default("UPLOADED")
  attempts Int @default(0)
  availableAt DateTime @default(now()) @map("available_at")
  leaseToken String? @map("lease_token")
  leaseUntil DateTime? @map("lease_until")
  heartbeatAt DateTime? @map("heartbeat_at")
  cancelledAt DateTime? @map("cancelled_at")
  errorCode String? @map("error_code")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  index KnowledgeIndexRevision @relation(fields:[indexRevisionId],references:[id],onDelete:Restrict)
  requests KnowledgeIngestionRequest[]
  @@unique([baseId, id], map:"kc_ingestion_job_base_id_id_key")
  @@unique([baseId, idempotencyKey])
  @@index([status, availableAt, leaseUntil])
  @@map("kc_ingestion_job")
}
/// Every accepted upload/reindex request key is immutable, including requests that reuse a job.
model KnowledgeIngestionRequest {
  baseId String @map("base_id")
  idempotencyKey String @map("idempotency_key")
  requestHash String @map("request_hash")
  jobId String @map("job_id")
  createdAt DateTime @default(now()) @map("created_at")
  base KnowledgeBase @relation(fields:[baseId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  job KnowledgeIngestionJob @relation(fields:[baseId,jobId],references:[baseId,id],onDelete:Restrict,onUpdate:Restrict)
  @@id([baseId,idempotencyKey])
  @@index([jobId])
  @@map("kc_ingestion_request")
}
model KnowledgeRelease {
