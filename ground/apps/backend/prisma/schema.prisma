  currentReleaseId String? @unique @map("current_release_id")
  ownerAgent OfficialAgent? @relation("ExpertOwnedKnowledgeBase", fields:[ownerAgentId], references:[id], onDelete:SetNull)
  currentRelease KnowledgeRelease? @relation("CurrentKnowledgeRelease", fields:[currentReleaseId], references:[id], onDelete:SetNull)
  createdAt DateTime @default(now()) @map("created_at")
  documents KnowledgeDocument[]
  ingestionRequests KnowledgeIngestionRequest[]
  releases KnowledgeRelease[] @relation("KnowledgeBaseReleases")
  @@index([scope, tenantId, enabled])
  @@map("kc_base")
}
model KnowledgeProfile {
  id String @id @default(cuid())
  providerId String @map("provider_id")
