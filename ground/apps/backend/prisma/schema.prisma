  expertVersionId String? @map("expert_version_id")
  previewId String? @map("preview_id")
  expertId String? @map("expert_id")
  releaseIds String[] @map("release_ids")
  status String
  evidence Json
  degradation String[]
  createdAt DateTime @default(now()) @map("created_at")
  @@index([actorUserId, requestId])
  @@index([tenantId, createdAt])
  @@map("kc_retrieval_trace")
}
model KnowledgeProviderUsage {
  id String @id @default(cuid())
  profileId String @map("profile_id")
  operationId String? @map("operation_id")
  task String
  inputCount Int @map("input_count")
  estimatedTokens Int @map("estimated_tokens")
  actualTokens Int? @map("actual_tokens")
  status String
  errorCode String? @map("error_code")
  createdAt DateTime @default(now()) @map("created_at")
  profile KnowledgeProfile @relation(fields:[profileId],references:[id],onDelete:Restrict)
  @@index([operationId])
  @@index([profileId, createdAt])
  @@map("kc_provider_usage")
}

model OfficialExpertPreview {
  id String @id @default(cuid())
  agentId String @map("agent_id")
  actorUserId String @map("actor_user_id")
  snapshot Json
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([actorUserId, expiresAt])
  @@map("official_expert_preview")
}

/// 登录、注册短信验证码。只存哈希。
model SmsVerificationCode {
  id         String    @id @default(cuid())
  phone      String    @db.VarChar(20)
  scene      String    @db.VarChar(32)
  codeHash   String    @map("code_hash") @db.VarChar(64)
  provider   String    @default("mock") @db.VarChar(16)
  sendIp     String    @default("") @map("send_ip") @db.VarChar(80)
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone, scene, createdAt])
  @@index([sendIp, createdAt])
  @@index([expiresAt])
  // 部分唯一索引 (phone, scene) WHERE consumed_at IS NULL 由迁移手工维护
  // （Prisma schema 不支持部分索引）；发码前会先 retireExpired 释放槽位。
  @@map("sms_verification_code")
}
