generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantType {
  PLATFORM
  AGENCY
  ENTERPRISE
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum RoleScope {
  PLATFORM
  ORG_PRESET
  /** 企业自建角色：必须挂 tenant_id，权限仅限 portal_console + Octop 业务包。 */
  ORG_CUSTOM
}

enum AccessScope {
  ALL
  SELECTED
}

enum KbStatus {
  PENDING
  READY
  FAILED
}

model User {
  libraryOwned LibraryNode[] @relation("LibraryOwner")
  libraryVersions LibraryVersion[] @relation("LibraryVersionAuthor")
  libraryRecents LibraryRecent[]
  custodyGrants LibraryCustody[] @relation("CustodyGrantor")
  custodyReceived LibraryCustody[] @relation("CustodyGrantee")

  id               String      @id @default(cuid())
  phone            String      @unique
  email            String?     @unique
  passwordHash     String      @map("password_hash")
  name             String
  /// Raster stored under uploads/user-avatars/. Null shows the name initial.
  avatarPath       String?     @map("avatar_path")
  isPlatformAdmin  Boolean     @default(false) @map("is_platform_admin")
  status           String      @default("active")
  peecaiUserId     String?     @unique @map("peecai_user_id")
  createdAt        DateTime    @default(now()) @map("created_at")
  /// Set when this account dismisses the one-time welcome. Null only for accounts created after the backfill.
  welcomeSeenAt    DateTime?   @map("welcome_seen_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  memberships      OrgMember[]
  agentGrants      AgentGrant[]
  kbGrants         KbGrant[]
  roles            UserRole[]
  tokenUsageTurns  TokenUsageTurn[]

  @@map("user")
}

model Tenant {
  libraryNodes LibraryNode[]
  libraryVersions LibraryVersion[]
  libraryChunks LibraryChunk[]
  libraryRecents LibraryRecent[]
  libraryCustodies LibraryCustody[]

  id               String      @id @default(cuid())
  name             String
  slug             String      @unique
  type             TenantType
  status           String      @default("active")
  logoUrl          String?     @map("logo_url")
  welcomeMessage   String      @default("") @map("welcome_message")
  defaultAgentId   String?     @map("default_agent_id")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  members          OrgMember[]
  roles            Role[]
  parents          OrgTree[]    @relation("ChildTenant")
  children         OrgTree[]    @relation("ParentTenant")
  agents           AgentRef[]
  kbFolders        KbFolder[]
  kbDocuments      KbDocument[]
  kbChunks         KbChunk[]
  usageEvents      UsageEvent[]
  quota            Quota?
  aiWallet         TenantAiWallet?
  aiRechargeOrders AiRechargeOrder[]
  tokenUsageTurns  TokenUsageTurn[]
  orgPresetOverrides OrgPresetOverride[]
  llmModelAssignments  LlmTenantModel[]
  officialAgentGrants OfficialAgentTenantGrant[]

  @@map("tenant")
}

model OrgTree {
  id        String   @id @default(cuid())
  parentId  String   @map("parent_id")
  childId   String   @map("child_id")
  parent    Tenant   @relation("ParentTenant", fields: [parentId], references: [id], onDelete: Cascade)
  child     Tenant   @relation("ChildTenant", fields: [childId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([parentId, childId])
  @@index([parentId])
  @@index([childId])
  @@map("org_tree")
}

model OrgMember {
  id        String     @id @default(cuid())
  userId    String     @map("user_id")
  tenantId  String     @map("tenant_id")
  /** 历史枚举，保留兼容；实际角色看 user_role。 */
  role      MemberRole @default(MEMBER)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @map("created_at")

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("org_member")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?  @map("tenant_id")
  userId    String?  @map("user_id")
  action    String
  ip        String?
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([userId])
  @@map("audit_log")
}

enum OfficialAgentKind {
  GENERAL
  KNOWLEDGE
}

enum OfficialAgentStatus {
  DRAFT
  PUBLISHED
  OFFLINE
}


enum OfficialAgentCategory {
  common
  productivity
  content
  sales
  expertise
  analytics
}

enum OfficialAgentGrantStatus {
  ACTIVE
  REVOKED
}

/// 可编辑草稿；线上配置只通过 OfficialAgentVersion 快照读取。
model OfficialAgent {
  id               String                    @id @default(cuid())
  key              String                    @unique
  kind             OfficialAgentKind
  /// 广场主分类；挂在可编辑父级，改分类不发新版本。
  category         OfficialAgentCategory?
  /// 内容向能力标签（中文）；工具能力由线上 version.toolScope 派生后合并，最多展示 3 个。
  capabilities     Json                      @default("[]")
  status           OfficialAgentStatus       @default(DRAFT)
  name             String
  summary          String                    @default("") @db.Text
  openingQuestions Json                      @default("[]") @map("opening_questions")
  systemPrompt     String                    @default("") @map("system_prompt") @db.Text
  toolScope        Json                      @default("[]") @map("tool_scope")
  onlineVersionId  String?                   @unique @map("online_version_id")
  onlineVersion    OfficialAgentVersion?     @relation("OnlineVersion", fields: [onlineVersionId], references: [id], onDelete: SetNull)
  versions         OfficialAgentVersion[]    @relation("AgentVersions")
  grants           OfficialAgentTenantGrant[]
  /// 专家关联的官方技能（草稿侧；发布时快照到 version.linkedSkillSummaries）。
  skillLinks       OfficialAgentSkillLink[]
  /// 猛犸官方知识资产（非企业私库）；按 agent 隔离检索。
  officialDocuments OfficialKbDocument[]
  /// Admin 上传的自定义头像相对路径（uploads/official-avatars/<uuid>.ext）；空则回退资产默认图。
  customAvatarPath String?                   @map("custom_avatar_path")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  @@map("official_agent")
  /// 增量专家定义与来源；旧记录为空，不回写旧指令。
  expertDefinition Json @default("{}") @map("expert_definition")
  executionConfig Json @default("{\"route\":\"LEGACY\"}") @map("execution_config")

  ownedKnowledgeBase KnowledgeBase? @relation("ExpertOwnedKnowledgeBase")
}

/// 发布时冻结展示和执行配置；版本行发布后不再更新。
model OfficialAgentVersion {
  id               String                    @id @default(cuid())
  agentId          String                    @map("agent_id")
  version          Int
  name             String
  summary          String                    @default("") @db.Text
  openingQuestions Json                      @default("[]") @map("opening_questions")
  systemPrompt     String                    @default("") @map("system_prompt") @db.Text
  toolScope        Json                      @default("[]") @map("tool_scope")
  /// Frozen Admin custom avatar path at publish time; terminal reads this, not draft parent.
  customAvatarPath String?                   @map("custom_avatar_path")
  publishedByUserId String?                  @map("published_by_user_id")
  publishedAt      DateTime                  @default(now()) @map("published_at")
  agent            OfficialAgent             @relation("AgentVersions", fields: [agentId], references: [id], onDelete: Cascade)
  onlineFor        OfficialAgent?            @relation("OnlineVersion")
  grants           OfficialAgentTenantGrant[]
  /// 发布时冻结的关联技能摘要（id/key/name/summary/packageRevision/enabledAt）。
  linkedSkillSummaries Json @default("[]") @map("linked_skill_summaries")
  /// 本版本发布时同步/绑定的官方知识文档快照引用。
  officialDocuments OfficialKbDocument[]

  @@unique([agentId, version])
  @@map("official_agent_version")
  /// 增量专家定义与来源；旧记录为空，不回写旧指令。
  expertDefinition Json @default("{}") @map("expert_definition")
  executionConfig Json @default("{\"route\":\"LEGACY\"}") @map("execution_config")

}

/// 企业开通固定到指定版本；撤销保留记录，执行侧每次仍需核验状态。
model OfficialAgentTenantGrant {
  id              String                   @id @default(cuid())
  agentId         String                   @map("agent_id")
  tenantId        String                   @map("tenant_id")
  versionId       String                   @map("version_id")
  status          OfficialAgentGrantStatus @default(ACTIVE)
  /// 仅资料型智能体使用；空数组表示不检索，绝不回退到全库。
  kbFolderIds     Json                     @default("[]") @map("kb_folder_ids")
  grantedByUserId String?                  @map("granted_by_user_id")
  revokedAt       DateTime?                @map("revoked_at")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  agent           OfficialAgent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  version         OfficialAgentVersion     @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([agentId, tenantId])
  @@index([tenantId, status])
  @@map("official_agent_tenant_grant")
}

/// 官方智能体专属知识文档（猛犸资产）。不挂企业 tenantId，检索仅按 agentId 隔离。
/// active=true 表示线上检索可见；替换时先建 active=false 的 staging，索引 READY 后再切换，失败保留旧知识。
model OfficialKbDocument {
  id            String                @id @default(cuid())
  agentId       String                @map("agent_id")
  /// 最近一次同步时绑定的冻结版本；便于审计追踪，检索仍按 agentId。
  versionId     String?               @map("version_id")
  /// 资产内相对键，如 1.md；同一 agent 下同时仅允许一份 active。
  assetKey      String                @map("asset_key")
  name          String
  originalName  String                @map("original_name")
  mimeType      String                @map("mime_type")
  sizeBytes     Int                   @map("size_bytes")
  storagePath   String                @map("storage_path")
  status        KbStatus              @default(PENDING)
  indexError    String?               @map("index_error")
  /// 线上生效标记。检索只读 active=true 且 status=READY。
  active        Boolean               @default(true)
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  agent         OfficialAgent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  version       OfficialAgentVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  chunks        OfficialKbChunk[]

  @@index([agentId, status])
  @@index([agentId, active, status])
  @@index([agentId, assetKey])
  @@map("official_kb_document")
}

model OfficialKbChunk {
  id         String             @id @default(cuid())
  agentId    String             @map("agent_id")
  documentId String             @map("document_id")
  ordinal    Int
  content    String
  createdAt  DateTime           @default(now()) @map("created_at")
  document   OfficialKbDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([documentId])
  @@map("official_kb_chunk")
}


enum OfficialSkillCategory {
  common
  content
  business
  expertise
  analytics
  office
  education
  ecommerce
  sales
  hr
  legal
  finance
  consulting
  research
  files
  search
  writing
  lifestyle
}

/// 官方技能（Ground 唯一内容源）。enabledAt 为空表示停用/未启用。
model OfficialSkill {
  id               String                 @id @default(cuid())
  key              String                 @unique
  name             String
  summary          String                 @default("") @db.Text
  categories       OfficialSkillCategory[] @default([])
  /// null = 停用/未启用；非空 = 启用时间（全员可见目录）。
  enabledAt        DateTime?              @map("enabled_at")
  /// 非空 = 已从管理列表和新使用入口移除；包、专家关联和历史读取仍保留。
  deletedAt        DateTime?              @map("deleted_at")
  currentRevision  Int                    @default(0) @map("current_revision")
  currentPackageId String?                @unique @map("current_package_id")
  currentPackage   OfficialSkillPackage?  @relation("CurrentPackage", fields: [currentPackageId], references: [id], onDelete: SetNull)
  packages         OfficialSkillPackage[] @relation("SkillPackages")
  agentLinks       OfficialAgentSkillLink[]
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  @@index([enabledAt])
  @@index([deletedAt])
  @@index([categories], type: Gin)
  @@map("official_skill")
  customAvatarPath String? @map("custom_avatar_path")
  /// Independent public discovery text; never package instructions or permissions.
  discoveryDetail Json @default("{}") @map("discovery_detail")
  /// Immutable crawl/import original for display rollback; never execution prompt.
  sourceName String? @map("source_name")
  sourceSummary String @default("") @map("source_summary") @db.Text
  /// source=as-imported, machine=LLM display fill, manual=admin edited display (do not overwrite).
  displayProvenance String @default("source") @map("display_provenance")
  displayLocale String @default("zh-Hans") @map("display_locale")
  displayTranslatedAt DateTime? @map("display_translated_at")
  displayModelRef String? @map("display_model_ref")
  /// sha256 of sourceName + "\n" + sourceSummary; skip machine rewrite when unchanged.
  displaySourceHash String? @map("display_source_hash")

}

/// 技能包 revision 快照；包文件落盘，数据库只存路径与最小 manifest。
model OfficialSkillPackage {
  id               String        @id @default(cuid())
  skillId          String        @map("skill_id")
  revision         Int
  /// uploads/official-skills/<skillId>/r<revision>/ 相对目录
  storagePath      String        @map("storage_path")
  /// 最小 manifest（key/name/description/entry/category/references），不含正文
  manifest         Json
  instructionBytes Int           @map("instruction_bytes")
  resourceCount    Int           @default(0) @map("resource_count")
  sourceZipPath    String?       @map("source_zip_path")
  createdAt        DateTime      @default(now()) @map("created_at")
  skill            OfficialSkill @relation("SkillPackages", fields: [skillId], references: [id], onDelete: Cascade)
  currentFor       OfficialSkill? @relation("CurrentPackage")

  @@unique([skillId, revision])
  @@index([skillId])
  @@map("official_skill_package")
}

/// 官方智能体草稿侧关联技能；发布时另快照到 OfficialAgentVersion.linkedSkillSummaries。
model OfficialAgentSkillLink {
  id        String        @id @default(cuid())
  agentId   String        @map("agent_id")
  skillId   String        @map("skill_id")
  createdAt DateTime      @default(now()) @map("created_at")
  agent     OfficialAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill     OfficialSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([agentId, skillId])
  @@index([skillId])
  @@map("official_agent_skill_link")
}

model AgentRef {
  id          String      @id @default(cuid())
  tenantId    String      @map("tenant_id")
  name        String
  persona     String      @default("")
  enabled     Boolean     @default(true)
  visibility  AccessScope @default(ALL)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  grants      AgentGrant[]

  @@index([tenantId])
  @@map("agent_ref")
}

model AgentGrant {
  id      String   @id @default(cuid())
  agentId String   @map("agent_id")
  userId  String   @map("user_id")
  agent   AgentRef @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agentId, userId])
  @@index([userId])
  @@map("agent_grant")
}

model KbFolder {
  id         String       @id @default(cuid())
  tenantId   String       @map("tenant_id")
  name       String
  createdAt  DateTime     @default(now()) @map("created_at")
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents  KbDocument[]

  @@index([tenantId])
  @@map("kb_folder")
}

model KbDocument {
  id           String      @id @default(cuid())
  tenantId     String      @map("tenant_id")
  folderId     String?     @map("folder_id")
  name         String
  originalName String      @map("original_name")
  mimeType     String      @map("mime_type")
  sizeBytes    Int         @map("size_bytes")
  storagePath  String      @map("storage_path")
  status       KbStatus    @default(PENDING)
  indexError   String?     @map("index_error")
  visibility   AccessScope @default(ALL)
  createdAt    DateTime    @default(now()) @map("created_at")
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folder       KbFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  grants       KbGrant[]
  chunks       KbChunk[]

  @@index([tenantId])
  @@index([folderId])
  @@map("kb_document")
}

model KbGrant {
  id         String     @id @default(cuid())
  documentId String     @map("document_id")
  userId     String     @map("user_id")
  document   KbDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@index([userId])
  @@map("kb_grant")
}

model KbChunk {
  id         String     @id @default(cuid())
  tenantId   String     @map("tenant_id")
  documentId String     @map("document_id")
  ordinal    Int
  content    String
  createdAt  DateTime   @default(now()) @map("created_at")
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document   KbDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([documentId])
  @@map("kb_chunk")
}

model UsageEvent {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  userId    String?  @map("user_id")
  kind      String
  quantity  Int      @default(1)
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([userId])
  @@map("usage_event")
}

model Quota {
  id            String   @id @default(cuid())
  tenantId      String   @unique @map("tenant_id")
  monthlyTurns  Int      @default(1000) @map("monthly_turns")
  monthlyTokens Int      @default(0) @map("monthly_tokens")
  updatedAt     DateTime @updatedAt @map("updated_at")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("quota")
}

/// 用户级月度 Token 额度（0 = 不限），企业级见 Quota.monthlyTokens。
model UserTokenQuota {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  userId        String   @map("user_id")
  monthlyTokens Int      @default(0) @map("monthly_tokens")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, userId])
  @@map("user_token_quota")
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  scope       RoleScope
  builtIn     Boolean          @default(true) @map("built_in")
  editable    Boolean          @default(false)
  /** ORG_CUSTOM 必填：角色归属企业，跨企业不可见。 */
  tenantId    String?          @map("tenant_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  permissions RolePermission[]
  users       UserRole[]
  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([scope])
  @@index([tenantId])
  @@map("role")
}

model RolePermission {
  id        String   @id @default(cuid())
  roleId    String   @map("role_id")
  permKey   String   @map("perm_key")
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([roleId, permKey])
  @@index([permKey])
  @@map("role_permission")
}

/// 用户的角色：可以有多个，权限取并集；所属企业另外由 org_member 表示（只能一家）。
model UserRole {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

/// 平台计费配置（单行 id=default）：售价倍率 + 1 AI币兑换 token 数。
model PlatformBillingConfig {
  id                  String   @id @default("default")
  /// 售价倍率，例如 1.5 表示按 token 折算后再乘 1.5
  sellPriceMultiplier Decimal  @default(1.5) @map("sell_price_multiplier") @db.Decimal(12, 4)
  /// 1 AI币 = N token
  tokensPerAiCoin     Int      @default(1000) @map("tokens_per_ai_coin")
  /// 1 元人民币兑换多少 AI 币（充值用）
  aiCoinsPerYuan      Int      @default(10000) @map("ai_coins_per_yuan")
  /// 新企业开户赠送金额（元）；0 = 不赠送。giftCoins = floor(welcomeGiftYuan * aiCoinsPerYuan)
  welcomeGiftYuan     Decimal  @default(5) @map("welcome_gift_yuan") @db.Decimal(12, 2)
  /// 上游采购单价 JSON：按 modelId（兼容遗留 deepseek/kimi）→ {input,output}，单位 ¥/1M tokens
  vendorUnitPrices    Json?    @map("vendor_unit_prices")
  /// 按 provider/model 配置采购价与可选售价倍率。
  modelUnitPrices     Json?    @map("model_unit_prices")
  /// 系统核验价格，跨重启保留有效参考价。
  systemPriceCatalog  Json?    @map("system_price_catalog")
  updatedAt           DateTime @updatedAt @map("updated_at")
  updatedByUserId     String?  @map("updated_by_user_id")

  @@map("platform_billing_config")
}

/// 企业 AI 币钱包（一企一账）。
model TenantAiWallet {
  id               String           @id @default(cuid())
  tenantId         String           @unique @map("tenant_id")
  balanceCoins     Int              @default(0) @map("balance_coins")
  totalCredited    Int              @default(0) @map("total_credited")
  totalDebited     Int              @default(0) @map("total_debited")
  status           String           @default("active")
  createdAt        DateTime         @default(now()) @map("created_at")
