/// 平台上游 LLM 厂商（方案1：Key 只存 Ground，Admin 采购配置）。
model LlmProvider {
  id          String     @id @default(cuid())
  /// 短名，用于 model_ref：deepseek / kimi
  name        String     @unique
  displayName String     @map("display_name")
  /// openai_compatible | 其它扩展
  kind        String     @default("openai_compatible")
  baseUrl     String?    @map("base_url")
  /// AES-256-GCM 密文；API 永不回传明文
  apiKeyEnc   String?    @map("api_key_enc") @db.Text
  /// 展示用掩码提示，如 sk-…abcd
  apiKeyHint  String?    @map("api_key_hint")
  note        String?    @db.Text
  enabled     Boolean    @default(true)
  sortOrder   Int        @default(0) @map("sort_order")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  knowledgeProfiles KnowledgeProfile[]
  health      LlmHealthState?
  models      LlmModel[]

  @@index([enabled, sortOrder])
  @@map("llm_provider")
}

/// 上游模型条目；启用后进入平台可用池（后续网关/Harness 消费）。
model LlmModel {
  id          String      @id @default(cuid())
  providerId  String      @map("provider_id")
  /// 上游 model id，如 deepseek-chat
  modelId     String      @map("model_id")
  displayName String      @map("display_name")
  enabled     Boolean     @default(true)
  /// 是否让上游开启 thinking；Flash 默认关，以降低首字延迟
  thinkingEnabled Boolean @default(false) @map("thinking_enabled")
  /// 平台首选（星标）；全局至多一个 true
  isPreferred Boolean     @default(false) @map("is_preferred")
  sortOrder   Int         @default(0) @map("sort_order")
  meta        Json?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  provider    LlmProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  health LlmHealthState?
  tenantAssignments LlmTenantModel[]

  @@unique([providerId, modelId])
  @@index([enabled, sortOrder])
  @@index([isPreferred])
  @@map("llm_model")
}


/// 企业模型例外：启用模型默认全员可用；本表只记停用与默认。
model LlmTenantModel {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  modelRowId String   @map("model_row_id")
  /// 该企业停用此模型（不出现在客户端列表、不可调用）
  blocked    Boolean  @default(false)
  /// 该企业默认模型（每租户至多一个 true，且不可与 blocked 同时为 true）
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  model      LlmModel @relation(fields: [modelRowId], references: [id], onDelete: Cascade)

  @@unique([tenantId, modelRowId])
  @@index([tenantId, isDefault])
  @@index([modelRowId])
  @@map("llm_tenant_model")
}

/// Manual enablement is independent from automatically observed health.
