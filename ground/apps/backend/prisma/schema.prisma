  enabled Boolean @default(true)
  deletedAt DateTime? @map("deleted_at")
  requestedIndexId String? @unique @map("requested_index_id")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  requestedIndex KnowledgeIndexRevision? @relation("RequestedFileIndex",fields:[requestedIndexId],references:[id],onDelete:SetNull)
  createdAt DateTime @default(now()) @map("created_at")
  base KnowledgeBase @relation(fields:[baseId],references:[id],onDelete:Restrict)
