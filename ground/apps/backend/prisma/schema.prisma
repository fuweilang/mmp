  lastUsedAt DateTime? @map("last_used_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@unique([scope, userId, kind, resourceId])
  @@index([scope, userId, kind, lastUsedAt])
  @@map("official_catalog_preference")
